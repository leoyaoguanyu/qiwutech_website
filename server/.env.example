# ---------- 基础 ----------
NODE_ENV=development
PORT=4000
# 允许跨域的前端地址（逗号分隔）。开发时 Vite 通过代理访问，可留空
CLIENT_ORIGINS=http://localhost:5173

# ---------- MongoDB ----------
# 本地：mongodb://127.0.0.1:27017/inspireomni
# 阿里云 ApsaraDB for MongoDB：mongodb://user:pass@dds-xxx.mongodb.rds.aliyuncs.com:3717/inspireomni?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/inspireomni

# ---------- 邮件通知（SMTP） ----------
# 留空 SMTP_HOST 时不会真正发信，只在日志中打印邮件内容（便于本地开发）
# 阿里云邮件推送示例：SMTP_HOST=smtpdm.aliyun.com  SMTP_PORT=465  SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# 发件人（需与 SMTP 账号一致或已在服务商验证）
MAIL_FROM="启物科技官网 <noreply@your-domain.com>"
# 接收询盘通知的公司邮箱，多个用逗号分隔
MAIL_TO=puzz@inspireomni.ai
# 是否向用户发送自动回复邮件
MAIL_AUTO_REPLY=true

# ---------- 管理接口 ----------
# 访问 GET /api/inquiries 等管理接口时需在请求头携带 x-admin-key。留空则关闭管理接口
ADMIN_API_KEY=

# ---------- 可选 ----------
# 验证码有效期（毫秒）
CAPTCHA_TTL_MS=300000
# 由 Express 直接托管前端构建产物 client/dist（不使用 Nginx 时设为 true）
SERVE_CLIENT=false
# 部署在 Nginx 等反向代理后面时设为 true，以正确识别客户端 IP
TRUST_PROXY=false
